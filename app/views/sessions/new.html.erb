<h1>Login</h1>

<%= form_with(scope: :session, url: login_path) do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "Login" %>
  </div>
<% end %>

<p>New user? <%= link_to "Sign up now!", new_user_path %></p>
