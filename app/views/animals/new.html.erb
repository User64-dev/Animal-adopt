<% content_for :title, "Add New Animal" %>

<div class="animal-form-card">
  <div class="animal-form-header">
    <h1><i class="fas fa-plus-circle"></i> Add New Animal</h1>
    <p>Fill in the details to list a new animal for adoption</p>
  </div>
  <div class="animal-form-body">
    <%= render "form", animal: @animal %>
    <div style="margin-top: 1rem;">
      <%= link_to "← Back to animals", animals_path, style: "color: var(--gray-500); text-decoration: none; font-size: 0.9rem;" %>
    </div>
  </div>
</div>

