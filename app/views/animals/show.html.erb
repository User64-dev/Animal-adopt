<p style="color: green"><%= notice %></p>

<%= render @animal %>

<div class="adoption-status-detail">
  <h3>Adoption Status</h3>
  <% if @animal.status_available? %>
    <div class="status-label status-available" style="display: inline-block; margin-bottom: 15px;">Available for Adoption</div>
  <% elsif @animal.status_pending? %>
    <div class="status-label status-pending" style="display: inline-block; margin-bottom: 15px;">Adoption in Progress</div>
  <% elsif @animal.status_adopted? %>
    <div class="status-label status-adopted" style="display: inline-block; margin-bottom: 15px;">Already Adopted</div>
  <% end %>
</div>

<div>
  <% if logged_in? %>
    <% if @animal.status_available? %>
      <%= button_to "Adopt this animal", adopt_animal_path(@animal), method: :post, class: "adopt-button" %>
    <% elsif @animal.adoptions.exists?(user: current_user) %>
      <p><strong>Status:</strong> <span class="adopted">You have applied to adopt this animal</span></p>
      <%= button_to "Cancel adoption", remove_adoption_animal_path(@animal), method: :delete, class: "cancel-adopt-button", data: { confirm: "Are you sure you want to cancel this adoption?" } %>
    <% else %>
      <p><strong>Status:</strong> <span class="adopted">This animal is not available for adoption</span></p>
    <% end %>
  <% else %>
    <p><%= link_to "Login to adopt this animal", login_path %></p>
  <% end %>
  
  <div class="admin-controls">
    <% if logged_in? && current_user.admin? %>
      <%= link_to "Edit this animal", edit_animal_path(@animal) %> |
      <%= button_to "Destroy this animal", @animal, method: :delete, data: { confirm: "Are you sure?" } %>
    <% end %>
  </div>
  
  <%= link_to "Back to animals", animals_path %>
</div>
