<p style="color: green"><%= notice %></p>

<%= render @animal %>

<div>
  <% if logged_in? %>
    <% if @animal.user.nil? %>
      <%= button_to "Adopt this animal", adopt_animal_path(@animal), method: :post, class: "adopt-button" %>
    <% elsif @animal.user == current_user %>
      <p><strong>Status:</strong> <span class="adopted">You have adopted this animal</span></p>
      <%= button_to "Cancel adoption", remove_adoption_animal_path(@animal), method: :delete, class: "cancel-adopt-button", data: { confirm: "Are you sure you want to cancel this adoption?" } %>
    <% else %>
      <p><strong>Status:</strong> <span class="adopted">This animal has already been adopted</span></p>
    <% end %>
  <% else %>
    <p><%= link_to "Login to adopt this animal", login_path %></p>
  <% end %>
  
  <div class="admin-controls">
    <% if logged_in? && current_user.admin? %>
      <%= link_to "Edit this animal", edit_animal_path(@animal) %> |
      <%= button_to "Destroy this animal", @animal, method: :delete, data: { confirm: "Are you sure?" } %>
    <% end %>
  </div>
  
  <%= link_to "Back to animals", animals_path %>
</div>
