<% if notice %>
  <div class="alert alert-success"><%= notice %></div>
<% end %>

<div class="animal-profile-container">
  <%= render @animal %>

  <div class="adoption-status-section">
    <h3>Adoption Status</h3>
    <% if @animal.status_available? %>
      <div class="status-badge status-available">
        <i class="fas fa-paw"></i> Available for Adoption
      </div>
    <% elsif @animal.status_pending? %>
      <div class="status-badge status-pending">
        <i class="fas fa-clock"></i> Adoption in Progress
      </div>
    <% elsif @animal.status_adopted? %>
      <div class="status-badge status-adopted">
        <i class="fas fa-home"></i> Already Adopted
      </div>
    <% end %>
  </div>

  <div class="adoption-actions">
    <% if logged_in? %>
      <% if @animal.status_available? %>
        <%= button_to adopt_animal_path(@animal), method: :post, class: "btn-adopt pulse-btn" do %>
          <i class="fas fa-heart"></i> Adopt <%= @animal.name %>
        <% end %>
        <p class="adoption-note"><i class="fas fa-info-circle"></i> By clicking "Adopt", you'll start the adoption process for <%= @animal.name %>.</p>
      <% elsif @animal.adoptions.exists?(user: current_user) %>
        <div class="adoption-status-info">
          <p><i class="fas fa-check-circle"></i> You have applied to adopt this animal</p>
          <%= button_to remove_adoption_animal_path(@animal), method: :delete, class: "btn-cancel-adoption", data: { confirm: "Are you sure you want to cancel this adoption request?" } do %>
            <i class="fas fa-times-circle"></i> Cancel Adoption Request
          <% end %>
        </div>
      <% else %>
        <div class="adoption-status-info not-available">
          <i class="fas fa-ban"></i> This animal is not available for adoption
        </div>
      <% end %>
    <% else %>
      <div class="login-prompt">
        <%= link_to login_path, class: "btn-login" do %>
          <i class="fas fa-sign-in-alt"></i> Login to Adopt This Animal
        <% end %>
      </div>
    <% end %>
  </div>
  
  <div class="admin-controls">
    <% if logged_in? && current_user.admin? %>
      <%= link_to edit_animal_path(@animal), class: "btn-admin" do %>
        <i class="fas fa-edit"></i> Edit
      <% end %>
      <%= button_to @animal, method: :delete, class: "btn-admin btn-danger", data: { confirm: "Are you sure you want to remove this animal?" } do %>
        <i class="fas fa-trash"></i> Remove
      <% end %>
    <% end %>
  </div>
  
  <%= link_to animals_path, class: "back-link" do %>
    <i class="fas fa-arrow-left"></i> Back to all animals
  <% end %>
</div>
