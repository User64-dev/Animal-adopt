<div id="<%= dom_id animal %>" class="animal-listing">
  <div class="status-tag-container">
    <% if animal.status_available? %>
      <span class="status-label status-available">Available</span>
    <% elsif animal.status_pending? %>
      <span class="status-label status-pending">Pending Adoption</span>
    <% elsif animal.status_adopted? %>
      <span class="status-label status-adopted">Adopted</span>
    <% end %>
  </div>
  <p>
    <strong>Name:</strong>
    <%= animal.name %>
  </p>

  <p>
    <strong>Type:</strong>
    <%= animal.animal_type %>
  </p>

  <p>
    <strong>Age:</strong>
    <%= animal.age %>
  </p>

  <p>
    <strong>Race:</strong>
    <%= animal.race %>
  </p>

</div>
