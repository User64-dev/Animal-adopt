<p style="color: green"><%= notice %></p>

<% content_for :title, "Animals" %>

<h1>Animals</h1>

<div id="animals" class="animals-container">
  <% @animals.each do |animal| %>
    <div class="animal-card">
      <%= render animal %>
      <p>
        <%= link_to "Show this animal", animal %>
      </p>
    </div>
  <% end %>
</div>

<%= link_to "New animal", new_animal_path %>
