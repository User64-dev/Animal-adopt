<% content_for :title, "Edit #{@animal.name}" %>

<div class="animal-form-card">
  <div class="animal-form-header">
    <h1><i class="fas fa-edit"></i> Edit <%= @animal.name %></h1>
    <p>Update the details for this animal</p>
  </div>
  <div class="animal-form-body">
    <%= render "form", animal: @animal %>
    <div style="margin-top: 1rem; display: flex; gap: 0.75rem;">
      <%= link_to "View Animal", @animal, style: "color: var(--green-600); text-decoration: none; font-size: 0.9rem; font-weight: 600;" %>
      <%= link_to "All Animals", animals_path, style: "color: var(--gray-500); text-decoration: none; font-size: 0.9rem;" %>
    </div>
  </div>
</div>

