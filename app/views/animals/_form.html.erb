<%= form_with(model: animal) do |form| %>
  <% if animal.errors.any? %>
    <div class="alert alert-danger">
      <strong><i class="fas fa-exclamation-circle"></i> <%= pluralize(animal.errors.count, "error") %> prevented saving:</strong>
      <ul>
        <% animal.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Animal Name" %>
    <%= form.text_field :name, class: "form-control", placeholder: "e.g., Max, Luna..." %>
  </div>

  <div class="form-group">
    <%= form.label :animal_type, "Type" %>
    <%= form.select :animal_type,
        [["Select type", ""], ["Dog", "Dog"], ["Cat", "Cat"], ["Bird", "Bird"], ["Rabbit", "Rabbit"], ["Other", "Other"]],
        {},
        class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :age, "Age (years)" %>
    <%= form.number_field :age, min: 0, max: 30, class: "form-control", placeholder: "e.g., 3" %>
  </div>

  <div class="form-group">
    <%= form.label :race, "Breed" %>
    <%= form.text_field :race, class: "form-control", placeholder: "e.g., Golden Retriever, Siamese..." %>
  </div>

  <div class="form-group" style="margin-top: 1.5rem">
    <%= form.submit animal.new_record? ? "Add Animal" : "Save Changes", class: "btn-submit" %>
  </div>
<% end %>
