<% content_for :title, "Admin - Adoption ##{@adoption.id}" %>

<div class="page-container">
  <div class="adoption-detail-card">
    <div class="adoption-detail-header">
      <div class="adoption-header-left">
        <h1>Adoption Application #<%= @adoption.id %></h1>
        <p class="text-muted">Submitted <%= @adoption.created_at.strftime("%B %d, %Y at %H:%M") %></p>
      </div>
      <div class="adoption-status-badge status-<%= @adoption.status %> large">
        <%= @adoption.status.capitalize %>
      </div>
    </div>

    <div class="detail-sections">
      <div class="detail-section">
        <h2><i class="fas fa-dog"></i> Animal</h2>
        <div class="detail-grid">
          <div class="detail-item">
            <span class="detail-label">Name</span>
            <span class="detail-value"><%= link_to @adoption.animal.name, animal_path(@adoption.animal) %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Type</span>
            <span class="detail-value"><%= @adoption.animal.animal_type %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Breed</span>
            <span class="detail-value"><%= @adoption.animal.race %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Animal Status</span>
            <span class="detail-value"><%= @adoption.animal.status.capitalize %></span>
          </div>
        </div>
      </div>

      <div class="detail-section">
        <h2><i class="fas fa-user"></i> Applicant</h2>
        <div class="detail-grid">
          <div class="detail-item">
            <span class="detail-label">Username</span>
            <span class="detail-value"><%= @adoption.user.username %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Email</span>
            <span class="detail-value"><%= @adoption.user.email %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Home Type</span>
            <span class="detail-value"><%= @adoption.home_type %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Has Yard</span>
            <span class="detail-value"><%= @adoption.has_yard ? "Yes" : "No" %></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Has Other Pets</span>
            <span class="detail-value"><%= @adoption.has_other_pets ? "Yes" : "No" %></span>
          </div>
          <% if @adoption.has_other_pets %>
            <div class="detail-item full-width">
              <span class="detail-label">Other Pets</span>
              <span class="detail-value"><%= @adoption.other_pets_description %></span>
            </div>
          <% end %>
        </div>
      </div>

      <div class="detail-section">
        <h2><i class="fas fa-comment-alt"></i> Adoption Reason</h2>
        <div class="reason-text">
          <%= @adoption.reason %>
        </div>
      </div>
    </div>

    <div class="adoption-detail-footer">
      <% if @adoption.pending? || @adoption.reviewing? %>
        <%= button_to "Approve Application", approve_admin_adoption_path(@adoption), method: :patch,
            class: "btn-approve" %>
        <%= button_to "Reject Application", reject_admin_adoption_path(@adoption), method: :patch,
            class: "btn-reject",
            data: { confirm: "Are you sure you want to reject this application?" } %>
      <% end %>
      <%= link_to "Back to All Applications", admin_adoptions_path, class: "btn-back" %>
    </div>
  </div>
</div>
