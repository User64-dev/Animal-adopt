<div id="<%= dom_id user %>">
  <p>
    <strong>Username:</strong>
    <%= user.username %>
  </p>
  <p>
    <strong>Email:</strong>
    <%= user.email %>
  </p>
  <% if user.admin? %>
    <p>
      <span class="admin-badge"><i class="fas fa-shield-alt"></i> Admin</span>
    </p>
  <% end %>
</div>
