<% content_for :title, "#{@user.username}'s Profile" %>

<div class="profile-card">
  <div class="profile-header">
    <div class="profile-avatar">
      <i class="fas fa-user"></i>
    </div>
    <h1><%= @user.username %></h1>
    <p><i class="fas fa-envelope"></i> <%= @user.email %></p>
    <% if @user.admin? %>
      <span class="admin-badge" style="margin-top: 0.5rem; display: inline-flex;"><i class="fas fa-shield-alt"></i> Admin</span>
    <% end %>
  </div>

  <div class="profile-body">
    <% if logged_in? && current_user == @user %>
      <div class="profile-section">
        <h2>My Adoptions</h2>
        <% user_adoptions = @user.adoptions.includes(:animal) %>
        <% if user_adoptions.empty? %>
          <p style="color: var(--gray-500); font-size: 0.9rem;">No adoptions yet. <%= link_to "Browse animals", animals_path %>!</p>
        <% else %>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <% user_adoptions.each do |adoption| %>
              <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: var(--gray-50); border-radius: var(--radius); border: 1px solid var(--gray-100);">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <i class="fas fa-paw" style="color: var(--green-500);"></i>
                  <strong><%= adoption.animal.name %></strong>
                  <span style="color: var(--gray-400); font-size: 0.85rem;"><%= adoption.animal.animal_type %></span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                  <span class="adoption-status-badge status-<%= adoption.status %>"><%= adoption.status.capitalize %></span>
                  <%= link_to "Details", adoption_path(adoption), class: "btn-view" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="profile-actions">
      <% if logged_in? && current_user == @user %>
        <%= link_to "Edit Profile", edit_user_path(@user), class: "btn-view" %>
        <%= link_to "My Adoptions", adoptions_path, class: "btn-back" %>
      <% end %>
      <% if logged_in? && current_user.admin? && current_user != @user %>
        <%= button_to "Delete User", @user, method: :delete, class: "btn-withdraw",
            data: { confirm: "Are you sure you want to delete this user?" } %>
      <% end %>
    </div>
  </div>
</div>

